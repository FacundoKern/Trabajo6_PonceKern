{
  "info": {
    "name": "Tienda API - TP Programación de Aplicaciones Móviles",
    "description": "Colección de pruebas para la API REST de gestión de productos, stock, compras y ventas. Incluye autenticación JWT, CRUD de entidades, paginado, carga de imagen y movimientos de stock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://tp5poncekern.somee.com" },
    { "key": "token", "value": "" },
    { "key": "categoriaId", "value": "1" },
    { "key": "productoId", "value": "1" },
    { "key": "proveedorId", "value": "1" },
    { "key": "clienteId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }",
                  "pm.test('Login OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"admin\",\n  \"password\": \"Admin123$\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Registrar usuario nuevo (requiere Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"empleado1\",\n  \"email\": \"empleado1@tienda.com\",\n  \"password\": \"Empleado123$\",\n  \"rol\": \"Empleado\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro"] }
          }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar categorias (paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categorias?pagina=1&tamanioPagina=10",
              "host": ["{{baseUrl}}"], "path": ["api", "categorias"],
              "query": [{ "key": "pagina", "value": "1" }, { "key": "tamanioPagina", "value": "10" }]
            }
          }
        },
        {
          "name": "Obtener categoria por Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}", "host": ["{{baseUrl}}"], "path": ["api", "categorias", "{{categoriaId}}"] }
          }
        },
        {
          "name": "Crear categoria (requiere Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Periféricos\",\n  \"descripcion\": \"Mouse, teclados, auriculares\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
          }
        },
        {
          "name": "Actualizar categoria (requiere Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Periféricos PC\",\n  \"descripcion\": \"Actualizado\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}", "host": ["{{baseUrl}}"], "path": ["api", "categorias", "{{categoriaId}}"] }
          }
        },
        {
          "name": "Eliminar categoria (requiere Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}", "host": ["{{baseUrl}}"], "path": ["api", "categorias", "{{categoriaId}}"] }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos (paginado + filtro categoria)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/productos?pagina=1&tamanioPagina=10&buscar=&categoriaId=",
              "host": ["{{baseUrl}}"], "path": ["api", "productos"],
              "query": [
                { "key": "pagina", "value": "1" },
                { "key": "tamanioPagina", "value": "10" },
                { "key": "buscar", "value": "" },
                { "key": "categoriaId", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Obtener producto por Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{productoId}}"] }
          }
        },
        {
          "name": "Crear producto (requiere Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mouse inalámbrico\",\n  \"descripcion\": \"Mouse óptico 2.4GHz\",\n  \"precio\": 8500.00,\n  \"categoriaId\": {{categoriaId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/productos", "host": ["{{baseUrl}}"], "path": ["api", "productos"] }
          }
        },
        {
          "name": "Actualizar producto (requiere Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mouse inalámbrico Pro\",\n  \"descripcion\": \"Mouse óptico 2.4GHz - actualizado\",\n  \"precio\": 9200.00,\n  \"categoriaId\": {{categoriaId}},\n  \"activo\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{productoId}}"] }
          }
        },
        {
          "name": "Subir imagen de producto (requiere Admin)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "archivo", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}/imagen", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{productoId}}", "imagen"] }
          }
        },
        {
          "name": "Eliminar producto (baja lógica, requiere Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["api", "productos", "{{productoId}}"] }
          }
        }
      ]
    },
    {
      "name": "Proveedores",
      "item": [
        {
          "name": "Listar proveedores (paginado)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/proveedores?pagina=1&tamanioPagina=10", "host": ["{{baseUrl}}"], "path": ["api", "proveedores"], "query": [{ "key": "pagina", "value": "1" }, { "key": "tamanioPagina", "value": "10" }] }
          }
        },
        {
          "name": "Crear proveedor (requiere Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"razonSocial\": \"Distribuidora Central SRL\",\n  \"cuit\": \"30-12345678-9\",\n  \"contacto\": \"Juan Pérez\",\n  \"telefono\": \"11-4444-5555\",\n  \"email\": \"ventas@distcentral.com\",\n  \"direccion\": \"Av. Siempre Viva 123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/proveedores", "host": ["{{baseUrl}}"], "path": ["api", "proveedores"] }
          }
        },
        {
          "name": "Actualizar proveedor (requiere Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"razonSocial\": \"Distribuidora Central SRL\",\n  \"cuit\": \"30-12345678-9\",\n  \"contacto\": \"Juan Pérez (actualizado)\",\n  \"telefono\": \"11-4444-5555\",\n  \"email\": \"ventas@distcentral.com\",\n  \"direccion\": \"Av. Siempre Viva 123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/proveedores/{{proveedorId}}", "host": ["{{baseUrl}}"], "path": ["api", "proveedores", "{{proveedorId}}"] }
          }
        },
        {
          "name": "Eliminar proveedor (baja lógica, requiere Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/proveedores/{{proveedorId}}", "host": ["{{baseUrl}}"], "path": ["api", "proveedores", "{{proveedorId}}"] }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar clientes (paginado)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/clientes?pagina=1&tamanioPagina=10", "host": ["{{baseUrl}}"], "path": ["api", "clientes"], "query": [{ "key": "pagina", "value": "1" }, { "key": "tamanioPagina", "value": "10" }] }
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"María\",\n  \"apellido\": \"Gómez\",\n  \"dni\": \"30111222\",\n  \"email\": \"maria.gomez@mail.com\",\n  \"telefono\": \"11-2222-3333\",\n  \"direccion\": \"Calle Falsa 456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/clientes", "host": ["{{baseUrl}}"], "path": ["api", "clientes"] }
          }
        },
        {
          "name": "Eliminar cliente (baja lógica, requiere Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/clientes/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["api", "clientes", "{{clienteId}}"] }
          }
        }
      ]
    },
    {
      "name": "Ingresos (compras a proveedor)",
      "item": [
        {
          "name": "Listar ingresos (paginado)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/ingresos?pagina=1&tamanioPagina=10", "host": ["{{baseUrl}}"], "path": ["api", "ingresos"], "query": [{ "key": "pagina", "value": "1" }, { "key": "tamanioPagina", "value": "10" }] }
          }
        },
        {
          "name": "Registrar ingreso de mercadería (requiere Admin, suma stock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proveedorId\": {{proveedorId}},\n  \"observaciones\": \"Compra mensual\",\n  \"detalles\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 20, \"precioUnitario\": 6000.00 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ingresos", "host": ["{{baseUrl}}"], "path": ["api", "ingresos"] }
          }
        }
      ]
    },
    {
      "name": "Salidas (ventas a cliente)",
      "item": [
        {
          "name": "Listar salidas (paginado)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/salidas?pagina=1&tamanioPagina=10", "host": ["{{baseUrl}}"], "path": ["api", "salidas"], "query": [{ "key": "pagina", "value": "1" }, { "key": "tamanioPagina", "value": "10" }] }
          }
        },
        {
          "name": "Registrar venta (resta stock, valida disponibilidad)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"observaciones\": \"Venta mostrador\",\n  \"detalles\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 2, \"precioUnitario\": 9200.00 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/salidas", "host": ["{{baseUrl}}"], "path": ["api", "salidas"] }
          }
        },
        {
          "name": "Registrar venta SIN stock suficiente (debe fallar con 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"observaciones\": \"Prueba de stock insuficiente\",\n  \"detalles\": [\n    { \"productoId\": {{productoId}}, \"cantidad\": 999999, \"precioUnitario\": 9200.00 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/salidas", "host": ["{{baseUrl}}"], "path": ["api", "salidas"] }
          }
        }
      ]
    }
  ]
}

@page "/"
@inject HttpClient Http

<h1>Tienda</h1>

<AuthorizeView>
    <p>Hola, <strong>@context.User.Identity?.Name</strong>.</p>
</AuthorizeView>

<p class="text-muted small">API: @ApiConfig.BaseUrl</p>

@if (verificando)
{
    <div class="alert alert-secondary">Verificando conexión con la API...</div>
}
else if (apiEnLinea)
{
    <div class="alert alert-success">API en línea.</div>
}
else
{
    <div class="alert alert-danger">No se pudo conectar con la API: @error</div>
}

<button class="btn btn-outline-primary" @onclick="VerificarApi" disabled="@verificando">Reintentar</button>

@code {
    private bool verificando = true;
    private bool apiEnLinea;
    private string? error;

    protected override Task OnInitializedAsync() => VerificarApi();

    private async Task VerificarApi()
    {
        verificando = true;
        error = null;
        try
        {
            var respuesta = await Http.GetAsync("api/productos?tamanioPagina=1");
            apiEnLinea = respuesta.IsSuccessStatusCode;
            if (!apiEnLinea) error = $"HTTP {(int)respuesta.StatusCode}";
        }
        catch (Exception ex)
        {
            apiEnLinea = false;
            error = ex.Message;
        }
        verificando = false;
    }
}

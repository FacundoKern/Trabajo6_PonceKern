@page "/ingresos/{Id:int}"
@inject IngresosService Servicio

<a href="ingresos" class="btn btn-link px-0 mb-2">&larr; Ingresos</a>

@if (cargando)
{
    <div class="text-center text-muted py-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">
        @error
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (ingreso is null)
{
    <div class="alert alert-warning">El ingreso no existe.</div>
}
else
{
    @if (Nuevo)
    {
        <div class="alert alert-success">Ingreso registrado. El stock de los productos ya se actualizó.</div>
    }

    <h1 class="h4 mb-3">Ingreso N° @ingreso.Id</h1>

    <div class="card mb-3">
        <div class="card-body">
            <dl class="datos mb-0">
                <dt>Fecha</dt>
                <dd>@Formato.FechaHora(ingreso.Fecha)</dd>

                <dt>Proveedor</dt>
                <dd>@ingreso.ProveedorNombre</dd>

                @if (!string.IsNullOrWhiteSpace(ingreso.Observaciones))
                {
                    <dt>Observaciones</dt>
                    <dd>@ingreso.Observaciones</dd>
                }
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6">Detalle</h2>
            @foreach (var d in ingreso.Detalles)
            {
                <div class="d-flex justify-content-between small gap-2">
                    <span>+@d.Cantidad × @d.ProductoNombre <span class="text-muted">(costo @Formato.Precio(d.PrecioUnitario))</span></span>
                    <span class="text-nowrap">@Formato.Precio(d.Subtotal)</span>
                </div>
            }
            <hr class="my-2" />
            <div class="d-flex justify-content-between fw-semibold fs-5">
                <span>Total</span>
                <span>@Formato.Precio(ingreso.Total)</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Viene en true cuando se llega recién registrado desde "Nuevo ingreso"
    [SupplyParameterFromQuery] public bool Nuevo { get; set; }

    private Ingreso? ingreso;
    private bool cargando = true;
    private string? error;

    protected override Task OnParametersSetAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;
        try
        {
            ingreso = await Servicio.ObtenerAsync(Id);
        }
        catch (Exception)
        {
            error = "No se pudo cargar el ingreso. Revisá la conexión.";
        }
        cargando = false;
    }
}

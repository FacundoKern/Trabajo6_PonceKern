@page "/producto/{Id:int}"
@inject CatalogoService Catalogo
@inject CarritoService Carrito

<button class="btn btn-link px-0 mb-2" @onclick="Volver">&larr; Volver al catálogo</button>

@if (cargando)
{
    <div class="text-center text-muted py-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">
        @error
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (producto is null)
{
    <div class="alert alert-warning">El producto no existe.</div>
}
else
{
    <div class="detalle">
        <div class="card overflow-hidden">
            <ImagenProducto Ruta="@producto.ImagenUrl" Alt="@producto.Nombre" />
        </div>

        <div>
            @if (producto.CategoriaNombre is not null)
            {
                <p class="text-muted small mb-1">@producto.CategoriaNombre</p>
            }
            <h1 class="h4">@producto.Nombre</h1>
            <p class="precio">@Formato.Precio(producto.Precio)</p>

            @if (!producto.Activo || producto.SinStock)
            {
                <p class="text-danger fw-semibold">Sin stock disponible</p>
            }
            else
            {
                <p class="text-success fw-semibold mb-1">Stock disponible</p>
                <p class="text-muted small">@producto.Stock @(producto.Stock == 1 ? "unidad" : "unidades")</p>

                @if (Disponible > 0)
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="small text-muted">Cantidad</span>
                        <div class="input-group input-group-sm selector-cantidad">
                            <button class="btn btn-outline-secondary" @onclick="() => cantidad--" disabled="@(cantidad <= 1)">&minus;</button>
                            <span class="form-control text-center">@cantidad</span>
                            <button class="btn btn-outline-secondary" @onclick="() => cantidad++" disabled="@(cantidad >= Disponible)">+</button>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 mb-2" @onclick="Agregar">Agregar al carrito</button>
                }
                else
                {
                    <p class="small text-muted">Ya tenés en el carrito todo el stock disponible.</p>
                }

                @if (mensaje is not null)
                {
                    <div class="alert alert-success py-2 d-flex justify-content-between align-items-center">
                        <span>@mensaje</span>
                        <a href="carrito" class="alert-link">Ver carrito</a>
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
            {
                <h2 class="h6 mt-4">Descripción</h2>
                <p class="descripcion">@producto.Descripcion</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private Producto? producto;
    private int cantidad = 1;
    private string? mensaje;
    private bool cargando = true;
    private string? error;

    protected override Task OnParametersSetAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;
        mensaje = null;
        cantidad = 1;
        try
        {
            producto = await Catalogo.ObtenerProductoAsync(Id);
        }
        catch (Exception)
        {
            error = "No se pudo cargar el producto. Revisá la conexión.";
        }
        cargando = false;
    }

    // Lo que todavía se puede agregar, descontando lo que ya está en el carrito
    private int Disponible => producto is null ? 0 : producto.Stock - Carrito.CantidadDe(producto.Id);

    private void Agregar()
    {
        if (producto is null) return;

        var agregadas = Carrito.Agregar(producto, cantidad);
        mensaje = agregadas == 1 ? "Se agregó 1 unidad al carrito." : $"Se agregaron {agregadas} unidades al carrito.";
        cantidad = 1;
    }

    // Igual que el botón "atrás" del teléfono
    private async Task Volver() => await JS.InvokeVoidAsync("history.back");
}

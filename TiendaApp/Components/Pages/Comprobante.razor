@page "/venta/{Id:int}"
@inject VentasService Ventas

@if (cargando)
{
    <div class="text-center text-muted py-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (error is not null)
{
    <div class="alert alert-danger">
        @error
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="CargarAsync">Reintentar</button>
    </div>
}
else if (venta is null)
{
    <div class="alert alert-warning">La venta no existe.</div>
}
else
{
    @if (!Nueva)
    {
        <a href="ventas" class="btn btn-link px-0 mb-2">&larr; Ventas</a>
    }

    @* El tilde queda también en el historial: muestra que la compra salió bien *@
    <div class="text-center mb-3">
        <svg class="tilde" viewBox="0 0 16 16" aria-hidden="true">
            <path fill="currentColor" d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
        </svg>
        <h1 class="h4 mt-2 mb-0">¡Compra aprobada!</h1>
        <p class="text-muted">Venta N° @venta.Id</p>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <dl class="datos mb-0">
                <dt>Fecha</dt>
                <dd>@Formato.FechaHora(venta.Fecha)</dd>

                <dt>Medio de pago</dt>
                <dd>
                    @venta.MedioPago
                    @if (venta.TarjetaUltimos4 is not null)
                    {
                        <span class="text-muted">terminada en @venta.TarjetaUltimos4</span>
                    }
                </dd>

                <dt>Estado</dt>
                <dd><span class="badge text-bg-success">@venta.EstadoPago</span></dd>

                @if (venta.CodigoOperacion is not null)
                {
                    <dt>Código de operación</dt>
                    <dd class="font-monospace">@venta.CodigoOperacion</dd>
                }

                <dt>Cliente</dt>
                <dd>@venta.ClienteNombre</dd>

                @if (!string.IsNullOrWhiteSpace(venta.Observaciones))
                {
                    <dt>Observaciones</dt>
                    <dd>@venta.Observaciones</dd>
                }
            </dl>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6">Detalle</h2>
            @foreach (var d in venta.Detalles)
            {
                <div class="d-flex justify-content-between small gap-2">
                    <span>@d.Cantidad × @d.ProductoNombre <span class="text-muted">(@Formato.Precio(d.PrecioUnitario))</span></span>
                    <span class="text-nowrap">@Formato.Precio(d.Subtotal)</span>
                </div>
            }
            <hr class="my-2" />
            <div class="d-flex justify-content-between fw-semibold fs-5">
                <span>Total</span>
                <span>@Formato.Precio(venta.Total)</span>
            </div>
        </div>
    </div>

    @* "Seguir comprando" solo tiene sentido recién terminada la compra, no al mirar una venta pasada *@
    @if (Nueva)
    {
        <div class="d-flex flex-column gap-2 mb-4">
            <a href="" class="btn btn-primary">Seguir comprando</a>
            <a href="ventas" class="btn btn-outline-secondary">Ver todas las ventas</a>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    // Viene en true cuando se llega desde el pago; desde el historial no viene
    [SupplyParameterFromQuery] public bool Nueva { get; set; }

    private Venta? venta;
    private bool cargando = true;
    private string? error;

    protected override Task OnParametersSetAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;
        try
        {
            venta = await Ventas.ObtenerAsync(Id);
        }
        catch (Exception)
        {
            error = "No se pudo cargar el comprobante. Revisá la conexión.";
        }
        cargando = false;
    }
}

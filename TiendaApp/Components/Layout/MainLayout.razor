@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject CarritoService Carrito

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <span class="usuario text-truncate">
                    @context.User.Identity?.Name
                    <span class="badge text-bg-secondary ms-1">@Rol(context)</span>
                </span>
                <a href="carrito" class="carrito" aria-label="Carrito">
                    <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
                        <path fill="currentColor" d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
                    </svg>
                    @if (Carrito.CantidadTotal > 0)
                    {
                        <span class="badge rounded-pill text-bg-danger">@Carrito.CantidadTotal</span>
                    }
                </a>
                <button class="btn btn-link" @onclick="Salir">Salir</button>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized() => Carrito.Cambio += AlCambiarCarrito;

    private static string? Rol(AuthenticationState estado) =>
        estado.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

    // Al cerrar la sesión, AuthorizeRouteView ve que no hay usuario y redirige al login
    private Task Salir() => Auth.LogoutAsync();

    private void AlCambiarCarrito() => InvokeAsync(StateHasChanged);

    public void Dispose() => Carrito.Cambio -= AlCambiarCarrito;
}
